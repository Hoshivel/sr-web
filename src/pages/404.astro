---
/*
  404 -- the branded "scattered into the void" page.

  This single `dist/404.html` serves **every** unmatched path (via
  `not_found_handling: "404-page"` in `wrangler.jsonc`), so the locale cannot be
  decided at build time: `/ja/typo` and `/en/typo` receive the same bytes. The
  page therefore always leads in the default locale, zh-Hant, with one English
  line so that someone who cannot read Chinese still learns what happened --
  rather than swapping strings client-side by path, which would only swap the body
  and not the header or footer, leaving a half-translated page.

  The copy comes from `src/i18n/ui.ts` (complete in all four languages), the same
  source as every other page.
*/
import Layout from "@/layouts/Layout.astro";
import Mark from "@/components/brand/Mark.astro";
import { useTranslations, DEFAULT_LOCALE } from "@/i18n/utils";

const t = useTranslations(DEFAULT_LOCALE);
const tEn = useTranslations("en");
const description = t("notFound.body");
---

<Layout
  locale={DEFAULT_LOCALE}
  title={`404 — ${t("site.name")}`}
  description={description}
  navigationPath="/"
>
  <main id="main" class="nf">
    <div class="sr-container nf__inner">
      <div class="nf__mark" aria-hidden="true"><Mark size={72} glow /></div>
      <p class="nf__code">404</p>
      <h1 class="nf__title sr-gradient-text">{t("notFound.title")}</h1>
      <p class="nf__sub">{description}</p>
      <p class="nf__sub nf__sub--en" lang="en">{tEn("notFound.body")}</p>
      <a class="sr-btn sr-btn--primary nf__home" href="/" data-magnetic>{t("a11y.home")}</a>
    </div>
  </main>
</Layout>

<style>
  .nf {
    position: relative;
    min-height: 72vh;
    display: grid;
    place-items: center;
    text-align: center;
    background:
      radial-gradient(55% 45% at 50% 38%, rgba(122, 91, 255, 0.1), transparent 70%),
      var(--sr-void);
  }
  .nf__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .nf__mark {
    margin-bottom: var(--sr-space-2);
    animation: nf-float 4.6s var(--sr-ease-in-out) infinite;
  }
  @keyframes nf-float {
    0%, 100% { transform: translateY(0); opacity: 0.9; }
    50% { transform: translateY(-6px); opacity: 1; }
  }
  .nf__code {
    font-family: var(--sr-font-display);
    font-weight: 800;
    font-size: var(--sr-text-2xl);
    letter-spacing: var(--sr-tracking-wide);
    color: var(--sr-text-dim);
  }
  .nf__title {
    font-family: var(--sr-font-display);
    font-weight: 800;
    font-size: var(--sr-text-xl);
    letter-spacing: 0.02em;
  }
  .nf__sub {
    color: var(--sr-text-muted);
    letter-spacing: 0.04em;
    font-size: var(--sr-text-sm);
  }
  .nf__sub--en {
    color: var(--sr-text-dim);
    max-width: 46ch;
  }
  .nf__home {
    margin-top: var(--sr-space-6);
    padding: 0.72rem 1.5rem;
  }
</style>
