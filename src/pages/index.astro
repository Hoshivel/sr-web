---
import Layout from "@/layouts/Layout.astro";
import Home from "@/components/Home.astro";

// zh-Hant (the default locale) is served at the root route /.
// Simplified /zh-cn and English /en are the parallel routes for their locales
// (see src/pages/).
const locale = "zh-Hant" as const;
---

<Layout locale={locale}>
  <Home locale={locale} />
</Layout>
