---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PreferenceBootstrap from "@/components/PreferenceBootstrap.astro";
import CookiePreferences from "@/components/CookiePreferences.astro";
import {
  useTranslations,
  localizedPath,
  stripLocalePrefix,
  HTML_LANG,
  OG_LOCALE,
  LOCALES,
  DEFAULT_LOCALE,
  type Locale,
} from "@/i18n/utils";

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  /** 404 可把語言切換器導回首頁，同時維持 section 連結指向真正的首頁。 */
  navigationPath?: string;
}

const { locale = DEFAULT_LOCALE, title, description, navigationPath } = Astro.props;
const t = useTranslations(locale);

// 預設標題把三個名字放在同一行：中文名、拉丁名、開發者。搜尋結果與分頁標題
// 是權重最高的那一塊，而「碎界」與「Shattered Realms」在字串上是兩個東西——
// 要它們被當成同一個作品，就得有地方同時寫著。各語系的寫法在 `site.title`。
const pageTitle = title ?? t("site.title");
const pageDescription = description ?? `${t("site.tagline")} — ${t("site.summary")}`;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// hreflang：把同一頁的各語言版本互相標示（含 x-default → 預設語言）。
const logicalPath = stripLocalePrefix(Astro.url.pathname);
const chromePath = navigationPath ?? logicalPath;
const isHomePage = logicalPath === "/";
const alternates = LOCALES.map((l) => ({
  hreflang: HTML_LANG[l],
  href: Astro.site
    ? new URL(localizedPath(l, logicalPath), Astro.site).href
    : localizedPath(l, logicalPath),
}));
const xDefault = Astro.site
  ? new URL(localizedPath(DEFAULT_LOCALE, logicalPath), Astro.site).href
  : localizedPath(DEFAULT_LOCALE, logicalPath);

const siteRoot = Astro.site?.href ?? "https://sr.hoshivel.com/";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteRoot}#website`,
      url: siteRoot,
      name: "Shattered Realms",
      alternateName: ["碎界", "砕界", "碎界 Shattered Realms"],
      inLanguage: LOCALES.map((l) => HTML_LANG[l]),
      publisher: { "@id": "https://hoshivel.com/#organization" },
    },
    {
      "@type": "VideoGame",
      "@id": `${siteRoot}#game`,
      url: siteRoot,
      name: "Shattered Realms",
      alternateName: ["碎界", "砕界"],
      inLanguage: LOCALES.map((l) => HTML_LANG[l]),
      description: t("site.summary"),
      gamePlatform: "Web browser",
      applicationCategory: "GameApplication",
      genre: ["Turn-based strategy", "Strategy"],
      author: { "@id": "https://hoshivel.com/#organization" },
      publisher: { "@id": "https://hoshivel.com/#organization" },
      mainEntityOfPage: { "@id": `${siteRoot}#website` },
    },
    {
      "@type": "Organization",
      "@id": "https://hoshivel.com/#organization",
      name: "Hoshivel",
      alternateName: ["星帆"],
      url: "https://hoshivel.com/",
    },
  ],
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 盡早標記 JS 可用：reveal 內容只在有 JS 時預先隱藏，避免無 JS 環境被永久藏住 -->
    <script is:inline>
      document.documentElement.classList.add("sr-js");
    </script>
    <PreferenceBootstrap locale={locale} path={logicalPath} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#06070b" />

    <!-- i18n 交替連結 -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Shattered Realms" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t("site.name")} — ${t("site.tagline")}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og.png" />
    <meta name="twitter:image:alt" content={`${t("site.name")} — ${t("site.tagline")}`} />

    <!-- 結構化資料（首頁）。兩件事各由一個型別回答：
         WebSite  —— 這個網域叫什麼、還叫什麼（Google 的 site name 讀 alternateName）
         VideoGame —— 這個作品是什麼、誰做的（把「碎界」與「Shattered Realms」
                      綁在同一個實體上，並指回 Hoshivel）
         name 與 alternateName 四個語系刻意一致：同一個網域對外只能有一種說法，
         語言差異交給 <title> 與 hreflang。 -->
    {isHomePage && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    )}
  </head>
  <body>
    <Header locale={locale} path={chromePath} isHome={isHomePage} />
    <slot />
    <Footer locale={locale} path={chromePath} isHome={isHomePage} />
    <CookiePreferences locale={locale} />

    <script>
      // 輕量互動啟動：reveal-on-scroll（IntersectionObserver）＋磁吸按鈕。
      // 皆為純 vanilla、reduced-motion 友善；不牽動 Lenis/GSAP/Pixi（那些於各自 island / Phase 3 boot）。
      import { initScrollReveal, initMagnetic } from "@/lib/motion";
      initScrollReveal();
      initMagnetic();
    </script>
  </body>
</html>
