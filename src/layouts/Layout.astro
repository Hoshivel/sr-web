---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PreferenceBootstrap from "@/components/PreferenceBootstrap.astro";
import CookiePreferences from "@/components/CookiePreferences.astro";
import {
  useTranslations,
  localizedPath,
  stripLocalePrefix,
  HTML_LANG,
  OG_LOCALE,
  LOCALES,
  DEFAULT_LOCALE,
  type Locale,
} from "@/i18n/utils";

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  /** 404 can point the language switcher back at the home page while section links still target the real home page. */
  navigationPath?: string;
}

const { locale = DEFAULT_LOCALE, title, description, navigationPath } = Astro.props;
const t = useTranslations(locale);

// The default title puts all three names on one line: the Chinese name, the
// Latin name and the developer. Search results and the tab title carry the most
// weight, and 「碎界」 and "Shattered Realms" are two different strings -- for
// them to be read as one work, somewhere has to spell both at once. Each locale's
// wording lives in `site.title`.
const pageTitle = title ?? t("site.title");
const pageDescription = description ?? `${t("site.tagline")} — ${t("site.summary")}`;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// hreflang: cross-link every language version of the same page (x-default points at the default locale).
const logicalPath = stripLocalePrefix(Astro.url.pathname);
const chromePath = navigationPath ?? logicalPath;
const isHomePage = logicalPath === "/";
const alternates = LOCALES.map((l) => ({
  hreflang: HTML_LANG[l],
  href: Astro.site
    ? new URL(localizedPath(l, logicalPath), Astro.site).href
    : localizedPath(l, logicalPath),
}));
const xDefault = Astro.site
  ? new URL(localizedPath(DEFAULT_LOCALE, logicalPath), Astro.site).href
  : localizedPath(DEFAULT_LOCALE, logicalPath);

const siteRoot = Astro.site?.href ?? "https://sr.hoshivel.com/";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteRoot}#website`,
      url: siteRoot,
      name: "Shattered Realms",
      alternateName: ["碎界", "砕界", "碎界 Shattered Realms"],
      inLanguage: LOCALES.map((l) => HTML_LANG[l]),
      publisher: { "@id": "https://hoshivel.com/#organization" },
    },
    {
      "@type": "VideoGame",
      "@id": `${siteRoot}#game`,
      url: siteRoot,
      name: "Shattered Realms",
      alternateName: ["碎界", "砕界"],
      inLanguage: LOCALES.map((l) => HTML_LANG[l]),
      description: t("site.summary"),
      gamePlatform: "Web browser",
      applicationCategory: "GameApplication",
      genre: ["Turn-based strategy", "Strategy"],
      author: { "@id": "https://hoshivel.com/#organization" },
      publisher: { "@id": "https://hoshivel.com/#organization" },
      mainEntityOfPage: { "@id": `${siteRoot}#website` },
    },
    {
      "@type": "Organization",
      "@id": "https://hoshivel.com/#organization",
      name: "Hoshivel",
      alternateName: ["星帆"],
      url: "https://hoshivel.com/",
    },
  ],
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mark JS availability as early as possible: reveal content is only pre-hidden when JS is present, so a JS-less environment never hides it forever -->
    <script is:inline>
      document.documentElement.classList.add("sr-js");
    </script>
    <PreferenceBootstrap locale={locale} path={logicalPath} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#06070b" />

    <!-- i18n alternate links -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Shattered Realms" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t("site.name")} — ${t("site.tagline")}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og.png" />
    <meta name="twitter:image:alt" content={`${t("site.name")} — ${t("site.tagline")}`} />

    <!-- Structured data (home page). One type answers each of two questions:
         WebSite   -- what this domain is called, and what else it is called
                      (Google reads alternateName for the site name)
         VideoGame -- what this work is and who made it (binding 「碎界」 and
                      "Shattered Realms" to one entity, and pointing back at Hoshivel)
         name and alternateName are deliberately identical across all four
         locales: one domain can only present one answer, and the language
         differences are left to <title> and hreflang. -->
    {isHomePage && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
      />
    )}
  </head>
  <body>
    <Header locale={locale} path={chromePath} isHome={isHomePage} />
    <slot />
    <Footer locale={locale} path={chromePath} isHome={isHomePage} />
    <CookiePreferences locale={locale} />

    <script>
      // Boot the lightweight interactions: reveal-on-scroll
      // (IntersectionObserver) plus the magnetic buttons.
      // Both are plain vanilla and reduced-motion aware, and neither pulls in
      // Lenis, GSAP or Pixi (those boot in their own islands or in Phase 3).
      import { initScrollReveal, initMagnetic } from "@/lib/motion";
      initScrollReveal();
      initMagnetic();
    </script>
  </body>
</html>
