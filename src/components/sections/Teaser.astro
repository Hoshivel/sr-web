---
/*
  預覽 Teaser（#teaser）—— Hero 之後的第一個區塊。
  只有眉標與播放器，沒有標題或說明文字：先讓訪客看它動起來，話留給後面的區塊。

  幻燈片式播放器：一次顯示一段，靠左右箭頭或圓點切換。
  只有當前那一段會播放，切走即暫停並倒回起點——避免兩段同時解碼。
  無 JS：第一段照樣顯示並自動播放，切換控制項對它無效（漸進增強）。
*/
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
  換裝槽：預覽片段。**上線時把 src 改成外部 URL**（CDN／物件儲存）即可，
  版面與腳本都不必動。

  現況為本機暫放：檔案來自 brand-assets，經 `public/media/` 提供，
  且已在 .gitignore 排除（合計約 158 MB，不入版控）。
  兩段皆 1920×1080（16:9），故框體固定 16/9。
*/
const PREVIEWS = [
  { src: "/media/preview-1.mp4", type: "video/mp4" },
  { src: "/media/preview-hakuto.mp4", type: "video/mp4" },
];
---

<section class="sr-section teaser" id="teaser">
  <div class="sr-container teaser__head">
    <p class="sr-eyebrow" data-reveal>{t("teaser.eyebrow")}</p>
  </div>

  <div class="sr-container teaser__stage" data-reveal>
    <div
      class="teaser__player"
      data-teaser-player
      role="group"
      aria-roledescription="carousel"
      aria-label={t("teaser.videoLabel")}
    >
      <div class="teaser__frame">
        {PREVIEWS.map((v, i) => (
          <video
            class="teaser__video"
            data-slide={i}
            aria-label={`${t("teaser.videoLabel")} ${i + 1} / ${PREVIEWS.length}`}
            width="1920"
            height="1080"
            autoplay={i === 0}
            muted
            loop
            playsinline
            preload={i === 0 ? "auto" : "none"}
            hidden={i !== 0}
          >
            <source src={v.src} type={v.type} />
          </video>
        ))}

        {PREVIEWS.length > 1 && (
          <>
            <button
              class="teaser__arrow teaser__arrow--prev"
              type="button"
              data-teaser-prev
              aria-label={t("teaser.prev")}
            >
              <span aria-hidden="true">‹</span>
            </button>
            <button
              class="teaser__arrow teaser__arrow--next"
              type="button"
              data-teaser-next
              aria-label={t("teaser.next")}
            >
              <span aria-hidden="true">›</span>
            </button>
          </>
        )}
      </div>

      {PREVIEWS.length > 1 && (
        <div class="teaser__dots" role="tablist" aria-label={t("teaser.videoLabel")}>
          {PREVIEWS.map((_, i) => (
            <button
              class="teaser__dot"
              type="button"
              role="tab"
              data-teaser-dot={i}
              aria-selected={i === 0 ? "true" : "false"}
              aria-label={`${t("teaser.videoLabel")} ${i + 1}`}
            ></button>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .teaser {
    position: relative;
    background:
      radial-gradient(65% 55% at 50% 0%, rgba(122, 162, 255, 0.07), transparent 70%),
      var(--sr-void);
  }
  .teaser__head {
    text-align: center;
  }
  .teaser__stage {
    margin-top: var(--sr-space-6);
  }

  .teaser__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--sr-border);
    border-radius: var(--sr-radius-lg);
    background: var(--sr-bg-deep);
    box-shadow: var(--sr-shadow-3);
  }
  .teaser__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--sr-bg-deep);
  }
  .teaser__video[hidden] {
    display: none;
  }

  /* 左右切換：常態半透明，hover / focus 才明顯，不搶畫面 */
  .teaser__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--sr-border-strong);
    border-radius: 50%;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--sr-text-bright);
    background: rgba(6, 7, 11, 0.55);
    -webkit-backdrop-filter: var(--sr-blur);
    backdrop-filter: var(--sr-blur);
    opacity: 0.55;
    transition:
      opacity var(--sr-dur-fast) var(--sr-ease-out),
      border-color var(--sr-dur-fast) var(--sr-ease-out);
  }
  .teaser__arrow:hover,
  .teaser__arrow:focus-visible {
    opacity: 1;
    border-color: var(--sr-accent);
  }
  .teaser__arrow--prev {
    left: clamp(0.6rem, 2vw, 1.2rem);
    padding-right: 3px; /* ‹ 的視覺重心偏右 */
  }
  .teaser__arrow--next {
    right: clamp(0.6rem, 2vw, 1.2rem);
    padding-left: 3px;
  }

  .teaser__dots {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: var(--sr-space-4);
  }
  .teaser__dot {
    width: 34px;
    height: 4px;
    border-radius: var(--sr-radius-pill);
    background: var(--sr-border-strong);
    transition: background var(--sr-dur-fast) var(--sr-ease-out);
  }
  .teaser__dot:hover {
    background: var(--sr-text-dim);
  }
  .teaser__dot[aria-selected="true"] {
    background: var(--sr-accent);
  }

  @media (max-width: 480px) {
    .teaser__arrow {
      width: 36px;
      height: 36px;
      font-size: 1.3rem;
    }
  }
</style>

<script>
  /*
    幻燈片切換：只有當前那一段可見並播放；切走的暫停並倒回起點，
    避免多段同時解碼（這些檔案很大）。非當前段以 preload="none" 起手，
    第一次被切到時才開始載入。
  */
  function initTeaser() {
    const player = document.querySelector<HTMLElement>("[data-teaser-player]");
    if (!player) return;

    const videos = [...player.querySelectorAll<HTMLVideoElement>(".teaser__video")];
    const dots = [...player.querySelectorAll<HTMLButtonElement>("[data-teaser-dot]")];
    if (videos.length < 2) return;

    const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    let current = 0;

    const show = (next: number) => {
      const i = (next + videos.length) % videos.length;
      if (i === current) return;

      videos[current].pause();
      videos[current].currentTime = 0;
      videos[current].hidden = true;

      const v = videos[i];
      v.hidden = false;
      // 首次切到時才真正拉取；之後瀏覽器自行快取
      if (v.preload === "none") v.preload = "auto";
      if (!reduced) void v.play().catch(() => {});

      dots.forEach((d, di) => d.setAttribute("aria-selected", String(di === i)));
      current = i;
    };

    player
      .querySelector("[data-teaser-prev]")
      ?.addEventListener("click", () => show(current - 1));
    player
      .querySelector("[data-teaser-next]")
      ?.addEventListener("click", () => show(current + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => show(i)));

    // 左右方向鍵：焦點在播放器內時可切換
    player.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        show(current - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        show(current + 1);
      }
    });

    // reduced-motion：不自動播放，改給控制列讓使用者自己決定
    if (reduced) {
      videos.forEach((v) => {
        v.autoplay = false;
        v.loop = false;
        v.controls = true;
        v.pause();
      });
    }
  }

  initTeaser();
</script>
