---
/*
  開始遊戲 Play（#play）——遊戲入口與內嵌遊玩區。
  header/footer 的「開始遊戲」與 hero Play CTA 皆錨至此。
  啟動器互動邏輯在 `PlayLauncher` island（client:visible）。
*/
import PlayLauncher from "@/components/sections/PlayLauncher.tsx";
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="sr-section play" id="play">
  <div class="sr-container play__head">
    <p class="sr-eyebrow" data-reveal>{t("play.eyebrow")}</p>
    <h2 class="play__title" data-reveal>
      <span class="play__title-a">{t("play.titleA")}</span>
      <span class="play__title-b sr-gradient-text">{t("play.titleB")}</span>
    </h2>
  </div>

  <div class="sr-container play__stage" data-reveal>
    <PlayLauncher client:visible locale={locale} />
  </div>

  <div class="sr-container">
    <p class="play__intro">{t("site.summary")}</p>
  </div>
</section>

<style>
  .play {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 50% 20%, rgba(122, 91, 255, 0.06), transparent 70%),
      var(--sr-void);
  }
  .play__head {
    text-align: center;
    max-width: 60rem;
  }
  .play__title {
    display: flex;
    flex-direction: column;
    gap: 0.12em;
    margin-top: var(--sr-space-3);
    font-family: var(--sr-font-display);
    font-weight: 800;
    font-size: var(--sr-text-2xl);
    line-height: var(--sr-leading-tight);
    letter-spacing: 0.02em;
  }
  .play__title-a {
    color: var(--sr-text-bright);
  }
  .play__stage {
    margin-top: var(--sr-space-12);
  }
  .play__intro {
    max-width: 40rem;
    margin: var(--sr-space-12) auto 0;
    color: var(--sr-text-muted);
    font-size: var(--sr-text-sm);
    line-height: 1.8;
    text-align: center;
  }
</style>
