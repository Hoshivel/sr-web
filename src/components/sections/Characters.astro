---
/*
  Characters (#characters) -- four character introductions.

  Deliberately **not** a roster screen: nobody stands at the center of this world,
  so this section avoids four character cards side by side (that is a gacha game's
  display case) in favor of an alternating left-right sequence -- one passage each,
  reading as an introduction rather than a list of selectable units.

  The information order follows the same principle: **who they are first, what
  they can do second**.
  role (which part of the story you meet them in) -> name -> epithet -> seeking
  (what they are looking for, the main text) -> combat (their combat role, as
  secondary information, separated by a thin rule and stepped down).

  Portraits are wired up (`public/art/portraits/`); anyone without one keeps the
  procedural placeholder (an element sigil plus a seeded constellation), so a
  character added later can simply leave `art: null` to take the placeholder branch.
  Entrance uses `[data-reveal]` stagger (Layout already boots it).
*/
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Seeded constellation: a deterministic set of stars per character (echoing the Starfield brand), as the texture behind the portrait.
function mulberry32(seed: number) {
  let a = seed >>> 0;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
// Portrait viewBox 100x130 (a 10:13 portrait format); generates the star points and one connecting constellation.
function constellation(seed: number) {
  const rnd = mulberry32(seed);
  const stars = Array.from({ length: 14 }, () => ({
    x: +(8 + rnd() * 84).toFixed(1),
    y: +(10 + rnd() * 110).toFixed(1),
    r: +(0.5 + rnd() * 1.4).toFixed(2),
  }));
  // Take the first 5 points and join them into one constellation path
  const path = stars.slice(0, 5).map((s, i) => `${i ? "L" : "M"}${s.x} ${s.y}`).join(" ");
  return { stars, path };
}

// The four characters: id -> element sigil glyph + element accent color (inline
// --el) + portrait (art). The copy comes from i18n.
// art null means the portrait is not wired up yet (procedural placeholder); a
// value overlays the real portrait slot. `as const` keeps the ids literal (so the
// i18n keys can be derived from them); rendering tests a local `art` variable so
// the placeholder branch is not narrowed to never (a character added later can
// leave art: null and take the placeholder).
const figures = [
  { id: "hakuto", glyph: "❄", el: "var(--sr-accent-ice)", seed: 0x1ce01, art: "/art/portraits/hakuto.webp" as string | null },
  { id: "shadow", glyph: "☾", el: "var(--sr-violet-light)", seed: 0x5bad0, art: "/art/portraits/shadow.webp" as string | null },
  { id: "sekien", glyph: "❂", el: "var(--sr-gold)", seed: 0xf1a3e, art: "/art/portraits/sekien.webp" as string | null },
  { id: "aoiro", glyph: "❦", el: "var(--sr-success)", seed: 0xa01a0, art: "/art/portraits/aoiro.webp" as string | null },
] as const;
---

<section class="sr-section characters" id="characters">
  <div class="sr-container characters__head">
    <p class="sr-eyebrow" data-reveal>{t("char.eyebrow")}</p>
    <h2 class="characters__title" data-reveal>
      <span class="characters__title-a">{t("char.titleA")}</span>
      <span class="characters__title-b sr-gradient-text">{t("char.titleB")}</span>
    </h2>
    <p class="characters__lead" data-reveal>{t("char.lead")}</p>
  </div>

  <ul class="sr-container characters__list">
    {figures.map((f) => {
      const c = constellation(f.seed);
      return (
        <li class="figure" style={`--el:${f.el}`} data-figure={f.id} data-reveal>
          <div class={`figure__portrait${f.art ? " has-art" : ""}`}>
            <svg class="figure__stars" viewBox="0 0 100 130" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
              <path d={c.path} class="figure__constellation" />
              {c.stars.map((s) => (
                <circle cx={s.x} cy={s.y} r={s.r} />
              ))}
            </svg>
            {f.art ? (
              <img
                class="figure__art"
                src={f.art}
                alt={t(`char.${f.id}.name`)}
                width="720"
                height="960"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <>
                <span class="figure__sigil" aria-hidden="true">{f.glyph}</span>
                <span class="figure__slot-note">{t("char.slotNote")}</span>
              </>
            )}
          </div>

          <div class="figure__body">
            {/* Tell the visitor first which part of the story they meet this person in */}
            <p class="figure__role">{t(`char.${f.id}.role`)}</p>
            <h3 class="figure__name sr-gradient-text">{t(`char.${f.id}.name`)}</h3>
            <p class="figure__epithet">{t(`char.${f.id}.epithet`)}</p>
            {/* Main text: what they are looking for -- this is what "who they are" means */}
            <p class="figure__seeking">{t(`char.${f.id}.seeking`)}</p>

            {/* Secondary information: what they can do in combat */}
            <div class="figure__combat">
              <p class="figure__combat-label">
                <span class="figure__combat-tag">{t("char.combat")}</span>
                <span class="figure__combat-el">{t(`char.${f.id}.element`)}</span>
              </p>
              <p class="figure__combat-text">{t(`char.${f.id}.fantasy`)}</p>
            </div>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .characters {
    position: relative;
    background:
      radial-gradient(55% 45% at 50% 100%, rgba(122, 91, 255, 0.07), transparent 70%),
      var(--sr-void);
  }

  .characters__head {
    text-align: center;
    max-width: 60rem;
  }
  .characters__title {
    display: flex;
    flex-direction: column;
    gap: 0.12em;
    margin-top: var(--sr-space-3);
    font-family: var(--sr-font-display);
    font-weight: 800;
    font-size: var(--sr-text-2xl);
    line-height: var(--sr-leading-tight);
    letter-spacing: 0.02em;
  }
  .characters__title-a {
    color: var(--sr-text-bright);
  }
  .characters__lead {
    margin: var(--sr-space-6) auto 0;
    max-width: 52ch;
    font-size: var(--sr-text-lg);
    color: var(--sr-text-muted);
  }

  /* The ensemble: one passage each, separated by thin rules -- not a display case in a row */
  .characters__list {
    list-style: none;
    margin-top: var(--sr-space-16);
    display: flex;
    flex-direction: column;
    gap: var(--sr-space-16);
  }

  .figure {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
  }
  .figure + .figure {
    padding-top: var(--sr-space-16);
    border-top: 1px solid var(--sr-border);
  }
  /* Alternating sides: it reads like the spread of a character introduction
     rather than a row of cells.
     The column widths have to flip with it -- otherwise the portrait lands in the
     wide column and becomes an image larger than the text itself. */
  .figure:nth-child(even) {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
  }
  .figure:nth-child(even) .figure__portrait {
    grid-column: 2;
    grid-row: 1;
  }
  .figure:nth-child(even) .figure__body {
    grid-column: 1;
    grid-row: 1;
  }

  /* Portrait: no card frame, its bottom dissolving into the void -- deliberately not a "card" */
  .figure__portrait {
    position: relative;
    aspect-ratio: 3 / 4;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--sr-radius-lg);
    background: radial-gradient(
      70% 58% at 50% 34%,
      color-mix(in srgb, var(--el) 20%, transparent),
      transparent 72%
    );
    -webkit-mask-image: linear-gradient(180deg, #000 62%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 62%, transparent 100%);
  }
  .figure__portrait :global(.figure__art) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    z-index: 3;
    filter: drop-shadow(0 8px 26px color-mix(in srgb, var(--el) 30%, transparent));
  }
  .figure__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--sr-star);
    opacity: 0.4;
  }
  .figure__constellation {
    fill: none;
    stroke: var(--el);
    stroke-width: 0.5;
    opacity: 0.45;
  }
  .figure__sigil {
    position: relative;
    z-index: 2;
    font-size: clamp(3.2rem, 8vw, 4.6rem);
    line-height: 1;
    color: var(--el);
    text-shadow: 0 0 26px color-mix(in srgb, var(--el) 70%, transparent);
    animation: figure-float 5.6s var(--sr-ease-in-out) infinite;
  }
  @keyframes figure-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
  .figure__slot-note {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12%;
    z-index: 2;
    text-align: center;
    font-size: var(--sr-text-xs);
    letter-spacing: var(--sr-tracking-wide);
    text-transform: uppercase;
    color: var(--sr-text-dim);
  }

  /* ---- Text: who they are first, what they can do second ---- */
  .figure__body {
    max-width: 56ch;
  }
  .figure__role {
    font-size: var(--sr-text-xs);
    letter-spacing: var(--sr-tracking-wide);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--el) 72%, var(--sr-text-muted));
  }
  .figure__name {
    margin-top: var(--sr-space-3);
    font-family: var(--sr-font-display);
    font-weight: 800;
    font-size: var(--sr-text-xl);
    line-height: 1.1;
    letter-spacing: 0.02em;
  }
  .figure__epithet {
    margin-top: var(--sr-space-1);
    font-size: var(--sr-text-sm);
    color: var(--sr-text-dim);
  }
  /* Main text: what they are looking for */
  .figure__seeking {
    margin-top: var(--sr-space-6);
    font-size: var(--sr-text-lg);
    line-height: var(--sr-leading);
    color: var(--sr-text);
    max-width: 44ch;
  }

  /* Secondary: the combat role. Separated by a thin rule, with the type size and brightness both stepped down */
  .figure__combat {
    margin-top: var(--sr-space-8);
    padding-top: var(--sr-space-4);
    border-top: 1px solid var(--sr-border);
    max-width: 46ch;
  }
  .figure__combat-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--sr-text-xs);
    letter-spacing: var(--sr-tracking-wide);
    text-transform: uppercase;
  }
  .figure__combat-tag {
    color: var(--sr-text-dim);
  }
  .figure__combat-el {
    color: color-mix(in srgb, var(--el) 78%, var(--sr-text-muted));
  }
  .figure__combat-text {
    margin-top: var(--sr-space-2);
    font-size: var(--sr-text-sm);
    line-height: var(--sr-leading);
    color: var(--sr-text-muted);
  }

  @media (max-width: 760px) {
    .characters__list {
      margin-top: var(--sr-space-12);
      gap: var(--sr-space-12);
    }
    /* In one column the alternation is dropped and the portrait always goes on top (the nth-child rule outweighs .figure, so it has to be overridden too) */
    .figure,
    .figure:nth-child(even) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sr-space-6);
    }
    .figure + .figure {
      padding-top: var(--sr-space-12);
    }
    .figure:nth-child(even) .figure__portrait,
    .figure:nth-child(even) .figure__body {
      grid-column: 1;
      grid-row: auto;
    }
    /* Every child of the portrait is absolute, so its content size is 0:
       centering requires an explicit width and cannot use margin-inline: auto --
       that would cancel the grid's stretch and collapse it to zero width. */
    .figure__portrait {
      width: min(20rem, 100%);
      justify-self: center;
    }
    .figure__body {
      max-width: none;
    }
  }
</style>
