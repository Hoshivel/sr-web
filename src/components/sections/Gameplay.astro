---
/*
  Gameplay (#gameplay) -- four pillars in one scroll-reveal.
  Hand / board movement / MOBA abilities and confrontation / SRPG: each pillar
  carries a procedural SVG motif (with no art assets, procedural *is* the
  illustration), entering with `[data-reveal]` stagger (Layout already boots it).
  The four pillars are not four buzzwords: each answers in one `claim` line what
  it decides in SR, giving the focus without unfolding an explanation -- the
  details of play belong to the game itself, not to the site.
  Static / reduced motion / no JS: the pillars render directly with their motifs
  still (the site-wide reduced-motion baseline disables the animation).
*/
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// For the hex board motif: procedurally generate the vertices of three flat-top hexagons in a honeycomb (procedural, echoing the hex board itself).
function hexPoints(cx: number, cy: number, r: number): string {
  const pts: string[] = [];
  for (let i = 0; i < 6; i++) {
    const a = (Math.PI / 3) * i; // 平頂：自 0° 起每 60°
    pts.push(`${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`);
  }
  return pts.join(" ");
}
const hexTriad = [hexPoints(18, 19, 7), hexPoints(30, 19, 7), hexPoints(24, 30, 7)];

// The four pillars: id -> element accent color (inline --el). The copy comes from i18n.
const pillars = [
  { id: "cards", el: "var(--sr-gold)" },
  { id: "board", el: "var(--sr-accent)" },
  { id: "skills", el: "var(--sr-violet-light)" },
  { id: "srpg", el: "var(--sr-success)" },
] as const;
---

<section class="sr-section gameplay" id="gameplay">
  {/* Procedural SVG motif sprites: they pick up each pillar's --el accent through currentColor */}
  <svg class="gameplay__sprite" aria-hidden="true" focusable="false">
    {/* Hand: three fanned cards, the middle one being the key card waiting to be played */}
    <symbol id="motif-cards" viewBox="0 0 48 48">
      <rect x="9" y="17" width="13" height="19" rx="2.4" transform="rotate(-18 15.5 26.5)" class="card" />
      <rect x="26" y="17" width="13" height="19" rx="2.4" transform="rotate(18 32.5 26.5)" class="card" />
      <rect x="17.5" y="14" width="13" height="19" rx="2.4" class="card card--lead" />
    </symbol>
    {/* Board movement: three honeycomb cells plus the piece resting on the leading one */}
    <symbol id="motif-board" viewBox="0 0 48 48">
      {hexTriad.map((p, i) => (
        <polygon points={p} class={i === 2 ? "hex hex--lead" : "hex"} />
      ))}
      <circle cx="24" cy="30" r="2.6" class="pawn" />
    </symbol>
    {/* MOBA abilities and confrontation: the ability ring plus three ability points */}
    <symbol id="motif-skills" viewBox="0 0 48 48">
      <circle cx="24" cy="24" r="12" class="orbit" />
      <circle cx="24" cy="24" r="3.4" class="core" />
      <circle cx="24" cy="12" r="2.4" class="pip pip--1" />
      <circle cx="34.4" cy="30" r="2.4" class="pip pip--2" />
      <circle cx="13.6" cy="30" r="2.4" class="pip pip--3" />
    </symbol>
    {/* SRPG: the character growth curve, step by step */}
    <symbol id="motif-srpg" viewBox="0 0 48 48">
      <rect x="9" y="30" width="6" height="8" rx="1.5" />
      <rect x="19" y="24" width="6" height="14" rx="1.5" />
      <rect x="29" y="16" width="6" height="22" rx="1.5" class="bar--lead" />
      <path d="M31 12 l4 -4 M35 8 h-4 M35 8 v4" class="spark" />
    </symbol>
  </svg>

  <div class="sr-container gameplay__head">
    <p class="sr-eyebrow" data-reveal>{t("gameplay.eyebrow")}</p>
    <h2 class="gameplay__title" data-reveal>
      <span class="gameplay__title-a">{t("gameplay.titleA")}</span>
      <span class="gameplay__title-b sr-gradient-text">{t("gameplay.titleB")}</span>
    </h2>
  </div>

  <ol class="sr-container gameplay__grid">
    {pillars.map((p) => (
      <li class="pillar" style={`--el:${p.el}`} data-pillar={p.id} data-reveal>
        <span class="pillar__motif-wrap" aria-hidden="true">
          <svg class="pillar__motif" viewBox="0 0 48 48"><use href={`#motif-${p.id}`} /></svg>
        </span>
        <h3 class="pillar__name">{t(`gameplay.${p.id}.name`)}</h3>
        {/* claim = what this pillar actually decides in SR. It gives the focus without unfolding an explanation */}
        <p class="pillar__claim">{t(`gameplay.${p.id}.claim`)}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .gameplay {
    position: relative;
    background:
      radial-gradient(60% 55% at 50% 0%, rgba(122, 162, 255, 0.06), transparent 70%),
      var(--sr-void);
  }
  /* The motif sprite sheet itself takes no layout space */
  .gameplay__sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .gameplay__head {
    text-align: center;
    max-width: 60rem;
  }
  .gameplay__title {
    display: flex;
    flex-direction: column;
    gap: 0.12em;
    margin-top: var(--sr-space-3);
    font-family: var(--sr-font-display);
    font-weight: 800;
    font-size: var(--sr-text-2xl);
    line-height: var(--sr-leading-tight);
    letter-spacing: 0.02em;
  }
  .gameplay__title-a {
    color: var(--sr-text-bright);
  }
  .gameplay__grid {
    list-style: none;
    margin-top: var(--sr-space-16);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
  }

  .pillar {
    position: relative;
    isolation: isolate;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid var(--sr-border);
    border-radius: var(--sr-radius-lg);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--el) 7%, var(--sr-surface-1)),
      var(--sr-surface-1) 60%
    );
    overflow: hidden;
    transition:
      transform var(--sr-dur) var(--sr-ease-out),
      border-color var(--sr-dur) var(--sr-ease-out),
      box-shadow var(--sr-dur) var(--sr-ease-out);
  }
  /* A thin rule along the top edge in the element color */
  .pillar::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--el), transparent);
    opacity: 0.55;
    transform: scaleX(0.4);
    transition:
      transform var(--sr-dur) var(--sr-ease-out),
      opacity var(--sr-dur) var(--sr-ease-out);
  }
  .pillar:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--el) 45%, var(--sr-border));
    box-shadow:
      var(--sr-shadow-2),
      0 0 42px color-mix(in srgb, var(--el) 22%, transparent);
  }
  .pillar:hover::before {
    transform: scaleX(1);
    opacity: 1;
  }

  .pillar__motif-wrap {
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: var(--sr-radius);
    color: var(--el);
    background: radial-gradient(
      70% 70% at 50% 40%,
      color-mix(in srgb, var(--el) 18%, transparent),
      transparent 72%
    );
  }
  .pillar__motif {
    width: 2.5rem;
    height: 2.5rem;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linejoin: round;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--el) 55%, transparent));
  }

  /* Motif details -- the cards (hand) */
  .card {
    opacity: 0.5;
  }
  .card--lead {
    opacity: 1;
    fill: color-mix(in srgb, currentColor 20%, transparent);
    animation: motif-breathe 4.4s var(--sr-ease-in-out) infinite;
  }
  /* board: honeycomb plus the piece */
  .hex {
    opacity: 0.55;
  }
  .hex--lead {
    opacity: 1;
    fill: color-mix(in srgb, currentColor 22%, transparent);
  }
  .pawn {
    fill: currentColor;
    stroke: none;
    transform-box: fill-box;
    transform-origin: center;
    animation: motif-step 4.4s var(--sr-ease-in-out) infinite;
  }
  /* srpg: the growth bars */
  .bar--lead {
    fill: color-mix(in srgb, currentColor 24%, transparent);
    animation: motif-rise 3.6s var(--sr-ease-in-out) infinite;
    transform-box: fill-box;
    transform-origin: bottom;
  }
  .spark {
    stroke-width: 1.5;
  }
  /* skills: the ability ring */
  .orbit {
    opacity: 0.5;
  }
  .core {
    fill: color-mix(in srgb, currentColor 40%, transparent);
    stroke: none;
  }
  .pip {
    fill: currentColor;
    stroke: none;
    transform-box: fill-box;
    transform-origin: center;
  }
  .pip--1 {
    animation: motif-twinkle 2.8s var(--sr-ease-in-out) infinite;
  }
  .pip--2 {
    animation: motif-twinkle 2.8s var(--sr-ease-in-out) 0.9s infinite;
  }
  .pip--3 {
    animation: motif-twinkle 2.8s var(--sr-ease-in-out) 1.8s infinite;
  }
  @keyframes motif-breathe {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 0.4; }
  }
  /* The piece "takes a step": settling gently into the leading cell */
  @keyframes motif-step {
    0%, 55%, 100% { transform: translateY(0); opacity: 1; }
    25% { transform: translateY(-3px); opacity: 0.75; }
  }
  @keyframes motif-rise {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.82); }
  }
  @keyframes motif-twinkle {
    0%, 100% { opacity: 0.35; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  .pillar__name {
    margin-top: var(--sr-space-6);
    font-family: var(--sr-font-display);
    font-weight: 700;
    font-size: var(--sr-text-xl);
    color: var(--sr-text-bright);
    letter-spacing: 0.01em;
  }
  /* What this pillar decides -- one sentence, and the card ends there */
  .pillar__claim {
    margin-top: var(--sr-space-2);
    font-size: var(--sr-text-base);
    font-weight: 600;
    line-height: var(--sr-leading-tight);
    color: color-mix(in srgb, var(--el) 72%, var(--sr-text-bright));
  }

  @media (max-width: 720px) {
    .gameplay__grid {
      grid-template-columns: 1fr;
      margin-top: var(--sr-space-12);
    }
  }
</style>
