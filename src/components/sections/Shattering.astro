---
/*
  碎裂 The Shattering（#world）—— 世界觀捲動電影。
  招牌「褪色（Fading）」溶解：一片凝聚的世界殘片，隨捲動向虛空四散、褪色淡出。

  本檔＝結構＋樣式＋種子化碎片場（SSR 決定性）。
  - 靜態 / reduced-motion / 無 JS：碎片呈凝聚態、文案以 `[data-reveal]` 呈現（世界「完整」的一刻）。
  - GSAP pin/scrub 電影於 `<script>`（Phase 3b）驅動 cluster → 四散＋褪色。
*/
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// 種子化碎片：凝聚於中央的殘片，各帶「向虛空四散」的目標位移（供 3b GSAP）。
function mulberry32(seed: number) {
  let a = seed >>> 0;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(0x5ca77e);
const COUNT = 34;
const shards = Array.from({ length: COUNT }, () => {
  const z = rnd(); // 深度 → 大小 / 亮度
  // 凝聚位置：中央附近（%）
  const cx = 50 + (rnd() - 0.5) * 40;
  const cy = 50 + (rnd() - 0.5) * 34;
  // 四散目標：由中央向外（px）
  const ang = rnd() * Math.PI * 2;
  const dist = 140 + rnd() * 460;
  const dx = Math.round(Math.cos(ang) * dist);
  const dy = Math.round(Math.sin(ang) * dist);
  const r0 = Math.round((rnd() - 0.5) * 60); // 起始旋轉
  const r1 = Math.round((rnd() - 0.5) * 320); // 四散旋轉
  const size = +(0.7 + z * 1.6).toFixed(2); // rem
  const op = +(0.25 + z * 0.5).toFixed(2);
  return { cx: cx.toFixed(2), cy: cy.toFixed(2), dx, dy, r0, r1, size, op, glyph: rnd() > 0.78 ? "◈" : "◆" };
});
---

<section class="shatter" id="world" data-scroll-cinema>
  <div class="shatter__shards" aria-hidden="true">
    {
      shards.map((s) => (
        <span
          class="shard"
          style={`left:${s.cx}%;top:${s.cy}%;--dx:${s.dx}px;--dy:${s.dy}px;--r0:${s.r0}deg;--r1:${s.r1}deg;font-size:${s.size}rem;--op:${s.op}`}
        >
          {s.glyph}
        </span>
      ))
    }
  </div>

  <div class="sr-container shatter__content">
    <p class="sr-eyebrow" data-reveal>{t("world.eyebrow")}</p>
    <h2 class="shatter__title" data-reveal>
      <span class="shatter__title-a">{t("world.titleA")}</span>
      <span class="shatter__title-b sr-gradient-text">{t("world.titleB")}</span>
    </h2>
    <p class="shatter__lead" data-reveal>{t("world.lead")}</p>
    <p class="shatter__body" data-reveal>{t("world.body")}</p>

    {/* 全站的核心命題：沒有主角，也就沒有中心。後續各區塊都由這句往下長。
        刻意不做高亮區塊——與前後文同色同級，讓它自己成立。 */}
    <p class="shatter__claim" data-reveal>{t("world.claim")}</p>
    <p class="shatter__ensemble" data-reveal>{t("world.ensemble")}</p>
  </div>
</section>

<style>
  .shatter {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 50% 40%, rgba(122, 91, 255, 0.08), transparent 70%),
      var(--sr-void);
  }

  .shatter__shards {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .shard {
    position: absolute;
    display: block;
    color: var(--sr-accent);
    opacity: var(--op);
    line-height: 1;
    /* 凝聚態：位於 left/top，僅套起始旋轉。3b 以 GSAP 動 --dx/--dy/--r1/opacity。 */
    transform: translate(-50%, -50%) rotate(var(--r0));
    text-shadow: 0 0 12px rgba(143, 169, 255, 0.35);
    will-change: transform, opacity, filter;
  }
  /* 交錯上色，讓殘片有冷暖層次 */
  .shard:nth-child(3n) {
    color: var(--sr-violet-light);
  }
  .shard:nth-child(4n) {
    color: var(--sr-accent-ice);
  }

  .shatter__content {
    position: relative;
    z-index: 1;
    max-width: 62rem;
    text-align: center;
    /* 內容底襯：保證字在殘片上仍清晰 */
  }
  .shatter__content::before {
    content: "";
    position: absolute;
    inset: -8% -6%;
    z-index: -1;
    background: radial-gradient(60% 60% at 50% 50%, rgba(6, 7, 11, 0.72), transparent 72%);
    pointer-events: none;
  }

  .shatter__title {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin-top: var(--sr-space-4);
    font-family: var(--sr-font-display);
    font-weight: 800;
    font-size: var(--sr-text-2xl);
    line-height: var(--sr-leading-tight);
    letter-spacing: 0.02em;
  }
  .shatter__title-a {
    color: var(--sr-text-bright);
  }

  /* 四段同字級同寬、不分區塊；差別只在顏色——
     其餘三段走灰階，唯獨核心命題留亮色，讓它自己跳出來。 */
  .shatter__lead,
  .shatter__body,
  .shatter__claim,
  .shatter__ensemble {
    margin: var(--sr-space-4) auto 0;
    font-size: var(--sr-text-lg);
    line-height: var(--sr-leading);
    color: var(--sr-text-muted);
    max-width: 46ch;
  }
  .shatter__lead {
    margin-top: var(--sr-space-8);
  }
  /* 核心命題：與前後同色，只靠字重站出來（CJK 的合成斜體不好看，用粗體）。 */
  .shatter__claim {
    font-weight: 700;
  }
</style>

<script>
  /*
    碎裂溶解電影：pin 住區塊，隨捲動 scrub 讓殘片由凝聚態向虛空四散＋淡出，
    殘片層同步去飽和 —— 招牌「褪色（Fading）」。文案維持可讀（靠 [data-reveal] 呈現）。
    reduced-motion → bootScrollCinema 回 null，直接略過（保留凝聚態靜態）。
  */
  import { bootScrollCinema } from "@/lib/scrollCinema";

  async function setup() {
    const section = document.querySelector<HTMLElement>("#world");
    if (!section) return;

    const cinema = await bootScrollCinema();
    if (!cinema) return;
    const { gsap, ScrollTrigger } = cinema;

    const shards = gsap.utils.toArray<HTMLElement>(".shard", section);
    if (shards.length === 0) return;
    const shardsWrap = section.querySelector<HTMLElement>(".shatter__shards");

    const num = (el: HTMLElement, name: string) =>
      parseFloat(el.style.getPropertyValue(name)) || 0;

    // 以 xPercent/yPercent 重現 CSS 的 translate(-50%,-50%) 置中（GSAP 會接管 transform）
    gsap.set(shards, { xPercent: -50, yPercent: -50 });
    shards.forEach((el) => gsap.set(el, { rotation: num(el, "--r0") }));

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "+=140%",
        pin: true,
        scrub: 0.6,
        anticipatePin: 1,
      },
    });

    // 殘片：向虛空四散 ＋ 淡出
    shards.forEach((el) => {
      tl.to(
        el,
        {
          x: num(el, "--dx"),
          y: num(el, "--dy"),
          rotation: num(el, "--r1"),
          opacity: 0.04,
          ease: "none",
        },
        0,
      );
    });

    // 整體褪色：殘片層去飽和
    if (shardsWrap) {
      tl.to(shardsWrap, { filter: "grayscale(0.7)", ease: "none" }, 0);
    }

    ScrollTrigger.refresh();
  }

  void setup();
</script>
