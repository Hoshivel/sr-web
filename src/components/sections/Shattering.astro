---
/*
  The Shattering (#world) -- the worldbuilding scroll cinema.
  The signature "Fading" dissolve: a clustered shard of the world scatters into
  the void and fades out as the reader scrolls.

  This file is structure, styles, and the seeded shard field (deterministic under SSR).
  - Static / reduced motion / no JS: the shards stay clustered and the copy is
    revealed with `[data-reveal]` (the moment the world is still whole).
  - The GSAP pin/scrub cinema in `<script>` (Phase 3b) drives cluster -> scatter
    plus fade.
*/
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Seeded shards: fragments clustered at the center, each carrying its target displacement for scattering into the void (used by the Phase 3b GSAP).
function mulberry32(seed: number) {
  let a = seed >>> 0;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(0x5ca77e);
const COUNT = 34;
const shards = Array.from({ length: COUNT }, () => {
  const z = rnd(); // 深度 → 大小 / 亮度
  // Clustered position: near the center (%)
  const cx = 50 + (rnd() - 0.5) * 40;
  const cy = 50 + (rnd() - 0.5) * 34;
  // Scatter target: outward from the center (px)
  const ang = rnd() * Math.PI * 2;
  const dist = 140 + rnd() * 460;
  const dx = Math.round(Math.cos(ang) * dist);
  const dy = Math.round(Math.sin(ang) * dist);
  const r0 = Math.round((rnd() - 0.5) * 60); // 起始旋轉
  const r1 = Math.round((rnd() - 0.5) * 320); // 四散旋轉
  const size = +(0.7 + z * 1.6).toFixed(2); // rem
  const op = +(0.25 + z * 0.5).toFixed(2);
  return { cx: cx.toFixed(2), cy: cy.toFixed(2), dx, dy, r0, r1, size, op, glyph: rnd() > 0.78 ? "◈" : "◆" };
});
---

<section class="shatter" id="world" data-scroll-cinema>
  <div class="shatter__shards" aria-hidden="true">
    {
      shards.map((s) => (
        <span
          class="shard"
          style={`left:${s.cx}%;top:${s.cy}%;--dx:${s.dx}px;--dy:${s.dy}px;--r0:${s.r0}deg;--r1:${s.r1}deg;font-size:${s.size}rem;--op:${s.op}`}
        >
          {s.glyph}
        </span>
      ))
    }
  </div>

  <div class="sr-container shatter__content">
    <p class="sr-eyebrow" data-reveal>{t("world.eyebrow")}</p>
    <h2 class="shatter__title" data-reveal>
      <span class="shatter__title-a">{t("world.titleA")}</span>
      <span class="shatter__title-b sr-gradient-text">{t("world.titleB")}</span>
    </h2>
    <p class="shatter__lead" data-reveal>{t("world.lead")}</p>

    {/* The site's central claim: with no protagonist there is no center. Every
        section that follows grows out of this sentence.
        Deliberately not set as a highlighted block -- same color and level as the
        text around it, so it stands on its own. */}
    <p class="shatter__claim" data-reveal>{t("world.claim")}</p>
    <p class="shatter__ensemble" data-reveal>{t("world.ensemble")}</p>
  </div>
</section>

<style>
  .shatter {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 50% 40%, rgba(122, 91, 255, 0.08), transparent 70%),
      var(--sr-void);
  }

  .shatter__shards {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .shard {
    position: absolute;
    display: block;
    color: var(--sr-accent);
    opacity: var(--op);
    line-height: 1;
    /* Clustered state: positioned by left/top with only the initial rotation applied. Phase 3b animates --dx/--dy/--r1/opacity with GSAP. */
    transform: translate(-50%, -50%) rotate(var(--r0));
    text-shadow: 0 0 12px rgba(143, 169, 255, 0.35);
    will-change: transform, opacity, filter;
  }
  /* Alternating colors, giving the shards a warm-cool depth */
  .shard:nth-child(3n) {
    color: var(--sr-violet-light);
  }
  .shard:nth-child(4n) {
    color: var(--sr-accent-ice);
  }

  .shatter__content {
    position: relative;
    z-index: 1;
    max-width: 62rem;
    text-align: center;
    /* Backing behind the content: keeps the text legible over the shards */
  }
  .shatter__content::before {
    content: "";
    position: absolute;
    inset: -8% -6%;
    z-index: -1;
    background: radial-gradient(60% 60% at 50% 50%, rgba(6, 7, 11, 0.72), transparent 72%);
    pointer-events: none;
  }

  .shatter__title {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin-top: var(--sr-space-4);
    font-family: var(--sr-font-display);
    font-weight: 800;
    font-size: var(--sr-text-2xl);
    line-height: var(--sr-leading-tight);
    letter-spacing: 0.02em;
  }
  .shatter__title-a {
    color: var(--sr-text-bright);
  }

  /* All four passages share a type size and measure with no block separation;
     the only difference is color -- three run in grayscale while the central
     claim alone keeps its brightness, so it steps forward by itself. */
  .shatter__lead,
  .shatter__claim,
  .shatter__ensemble {
    margin: var(--sr-space-4) auto 0;
    font-size: var(--sr-text-lg);
    line-height: var(--sr-leading);
    color: var(--sr-text-muted);
    max-width: 46ch;
  }
  .shatter__lead {
    margin-top: var(--sr-space-8);
  }
  /* The central claim: the same color as its neighbors, standing out through weight and italics. */
  .shatter__claim {
    font-weight: 700;
    font-style: italic;
  }
</style>

<script>
  /*
    The shattering dissolve cinema: pin the section and scrub the shards from
    their clustered state outward into the void while fading them, desaturating
    the shard layer in step -- the signature "Fading". The copy stays readable
    (revealed by [data-reveal]).
    Under reduced motion bootScrollCinema returns null and this is skipped
    entirely, leaving the static clustered state.
  */
  import { bootScrollCinema } from "@/lib/scrollCinema";

  async function setup() {
    const section = document.querySelector<HTMLElement>("#world");
    if (!section) return;

    const cinema = await bootScrollCinema();
    if (!cinema) return;
    const { gsap, ScrollTrigger } = cinema;

    const shards = gsap.utils.toArray<HTMLElement>(".shard", section);
    if (shards.length === 0) return;
    const shardsWrap = section.querySelector<HTMLElement>(".shatter__shards");

    const num = (el: HTMLElement, name: string) =>
      parseFloat(el.style.getPropertyValue(name)) || 0;

    // Reproduce the CSS translate(-50%,-50%) centering with xPercent/yPercent (GSAP takes over the transform)
    gsap.set(shards, { xPercent: -50, yPercent: -50 });
    shards.forEach((el) => gsap.set(el, { rotation: num(el, "--r0") }));

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "+=140%",
        pin: true,
        scrub: 0.6,
        anticipatePin: 1,
      },
    });

    // Shards: scatter into the void and fade out
    shards.forEach((el) => {
      tl.to(
        el,
        {
          x: num(el, "--dx"),
          y: num(el, "--dy"),
          rotation: num(el, "--r1"),
          opacity: 0.04,
          ease: "none",
        },
        0,
      );
    });

    // The overall fade: desaturate the shard layer
    if (shardsWrap) {
      tl.to(shardsWrap, { filter: "grayscale(0.7)", ease: "none" }, 0);
    }

    ScrollTrigger.refresh();
  }

  void setup();
</script>
