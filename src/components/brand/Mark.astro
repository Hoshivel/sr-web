---
/*
  Shattered Realms brand mark ◈ -- the SVG version (scalable, gradient, optional glow).
  The geometry follows favicon.svg: an outer stroked diamond plus an inner filled
  diamond with a gradient.
  With a title it renders role="img" + aria-label; without one it is aria-hidden,
  i.e. purely decorative, leaving the meaning to the adjacent text.
*/
interface Props {
  size?: number;
  glow?: boolean;
  title?: string;
  class?: string;
}
const { size = 32, glow = false, title, class: className } = Astro.props;

// A separate gradient id per instance, so several Marks on one page cannot collide
const gid = `sr-mark-grad-${Math.random().toString(36).slice(2, 8)}`;
const a11y = title
  ? { role: "img" as const, "aria-label": title }
  : { "aria-hidden": "true" as const };
---

<svg
  class:list={["sr-mark", { "is-glow": glow }, className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  xmlns="http://www.w3.org/2000/svg"
  {...a11y}
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#cdd7ff"></stop>
      <stop offset="0.45" stop-color="#8fa9ff"></stop>
      <stop offset="1" stop-color="#b89bff"></stop>
    </linearGradient>
  </defs>
  <path
    d="M16 3 L29 16 L16 29 L3 16 Z"
    fill="none"
    stroke={`url(#${gid})`}
    stroke-width="1.5"
    opacity="0.75"></path>
  <path d="M16 8.5 L23.5 16 L16 23.5 L8.5 16 Z" fill={`url(#${gid})`}></path>
</svg>

<style>
  .sr-mark {
    display: block;
    overflow: visible;
  }
  .sr-mark.is-glow {
    filter: drop-shadow(0 0 10px rgba(143, 169, 255, 0.5));
  }
</style>
