---
/*
  Home page content (the single authoritative source; shared by all locale routes,
  with the copy switched by the locale prop).
  The hero is layered: bg (the procedural void, hydrating a canvas island),
  scrim, content.

  The section order is the narrative line:
  hero -> gameplay footage -> why the world shattered (nobody stands at the
  center) -> core gameplay (how a conflict is decided) -> the Shattered Realms
  Tree (journeys crossing between fragments) -> characters (each walking toward a
  different answer) -> actually playing.
*/
import Mark from "@/components/brand/Mark.astro";
import VoidField from "@/components/hero/VoidField.tsx";
import Starfield from "@/components/hero/Starfield.tsx";
import Teaser from "@/components/sections/Teaser.astro";
import { HAS_PREVIEWS } from "@/config/media";
import Shattering from "@/components/sections/Shattering.astro";
import Gameplay from "@/components/sections/Gameplay.astro";
import Chapters from "@/components/sections/Chapters.astro";
import Characters from "@/components/sections/Characters.astro";
import Play from "@/components/sections/Play.astro";
import { useTranslations, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
// The en headline is already Latin, so the Latin subtitle is not repeated
const showLatin = locale !== "en";

// CTA targets: Play goes to the Phase 6 launcher; Learn goes to the world
// (shattering) section.
// The scroll indicator points at whatever follows the hero: #teaser when a
// preview exists, otherwise straight to #world (with no video origin configured
// the whole preview section is not emitted, so the anchor must not be left
// pointing at nothing).
const playHref = "#play";
const learnHref = "#world";
const nextHref = HAS_PREVIEWS ? "#teaser" : learnHref;
---

<main id="main">
  <section class="hero" id="top">
    <!-- Background layer: the procedural void. Pixi VoidField (WebGL) below, Starfield (constellations) above it -->
    <div class="hero__bg" aria-hidden="true">
      <VoidField client:visible />
      <Starfield client:visible interactive density={1} />
    </div>
    <!-- Fade out at the bottom so the hero blends into the sections below -->
    <div class="hero__scrim" aria-hidden="true"></div>
    <!-- Central radial dimming: keeps the wordmark and tagline legible over the void -->
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="sr-container hero__content">
      <div class="hero__mark" data-reveal>
        <Mark size={64} glow title={t("site.name")} />
      </div>
      <!-- The title is one h1 holding two lines. The Latin name used to be a
           <p> outside the h1, which made 「碎界」 and "Shattered Realms" two
           separate things to a search engine -- but they are two names for one
           work, and to be read as one they have to sit inside the same heading.
           Nothing changed visually: the two lines still lay out separately and
           the all-caps is done in CSS. -->
      <h1 class="hero__title" data-reveal>
        <span class="hero__title-name sr-gradient-text">{t("site.name")}</span>{" "}
        {showLatin && <span class="hero__latin">{t("site.nameLatin")}</span>}
      </h1>
      <p class="hero__tagline" data-reveal>{t("site.tagline")}</p>

      <div class="hero__cta" data-reveal>
        <a class="sr-btn sr-btn--primary" href={playHref} data-magnetic>
          {t("cta.play")}
        </a>
        <a class="sr-btn sr-btn--ghost" href={learnHref} data-magnetic>
          {t("cta.learn")}
        </a>
      </div>
    </div>

    <a class="hero__scroll" href={nextHref} aria-label={t("teaser.eyebrow")}>
      <span class="hero__scroll-track"><span class="hero__scroll-dot"></span></span>
    </a>
  </section>

  <!-- Preview: let a visitor see it move before explaining why the world
       shattered. The video origin is decided by src/config/media.ts (external
       storage); with none configured the whole section is not emitted. -->
  {HAS_PREVIEWS && <Teaser locale={locale} />}

  <!-- The Shattering (the worldbuilding scroll cinema): why the world shattered, and how nobody stands at the center -->
  <Shattering locale={locale} />

  <!-- Core gameplay: four pillars, each answering what it decides -->
  <Gameplay locale={locale} />

  <!-- The Shattered Realms Tree: journeys reaching between fragments and crossing one another -->
  <Chapters locale={locale} />

  <!-- Characters: crossing journeys, each walking toward a different answer -->
  <Characters locale={locale} />

  <!-- Play (the region list and the embedded game entry point) -->
  <Play locale={locale} />
</main>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
    overflow: hidden;
  }

  /* Procedural void base: a radial glow (the canvas island layers above it) */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: var(--sr-z-bg);
    background:
      radial-gradient(
        60% 50% at 50% 28%,
        rgba(122, 162, 255, 0.14),
        transparent 70%
      ),
      radial-gradient(
        45% 40% at 72% 82%,
        rgba(122, 91, 255, 0.12),
        transparent 70%
      ),
      var(--sr-void);
  }
  /* The hydrated canvas fills the background layer and passes pointer events through */
  .hero__bg :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* Host container for the Pixi void: fills the background layer (Pixi resizeTo takes its size from this) */
  .hero__bg :global(.sr-voidfield) {
    position: absolute;
    inset: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 62%,
      rgba(6, 7, 11, 0.55) 88%,
      var(--sr-void) 100%
    );
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: radial-gradient(
      50% 46% at 50% 44%,
      rgba(6, 7, 11, 0.58),
      transparent 68%
    );
  }

  .hero__content {
    position: relative;
    z-index: var(--sr-z-content);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__mark {
    margin-bottom: 0.5rem;
    animation: hero-pulse 4.2s var(--sr-ease-in-out) infinite;
  }
  @keyframes hero-pulse {
    0%,
    100% {
      transform: translateY(0) scale(1);
      opacity: 0.92;
    }
    50% {
      transform: translateY(-4px) scale(1.05);
      opacity: 1;
    }
  }

  /* The h1 only stacks the two lines; the typeface and glow stay on the Chinese
     name's line, or the Latin subtitle would be swallowed by the same gradient
     fill and drop-shadow. */
  /* flex rather than grid: the whitespace character between the two spans has to
     survive (`碎界 Shattered Realms` is one string, not two), and grid would turn
     it into an empty grid item taking up an extra row; flex creates no item for
     pure whitespace. */
  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .hero__title-name {
    font-family: var(--sr-font-display);
    font-weight: 800;
    font-size: var(--sr-text-display);
    letter-spacing: var(--sr-tracking-wide);
    line-height: 1;
    padding-inline: 0.2em;
    filter: drop-shadow(0 2px 24px rgba(122, 162, 255, 0.28));
  }
  .hero__latin {
    /* The text itself is in normal case (see site.nameLatin in i18n/ui.ts); the
       all-caps is purely visual.
       The typeface is inherited from body (the h1 no longer specifies one), but
       the bold has to be undone explicitly -- this used to be a <p>. */
    font-weight: 400;
    color: var(--sr-text-muted);
    letter-spacing: var(--sr-tracking-wider);
    font-size: var(--sr-text-sm);
    text-transform: uppercase;
  }
  .hero__tagline {
    margin-top: 1.2rem;
    color: var(--sr-text);
    letter-spacing: 0.06em;
    font-size: var(--sr-text-lg);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.4rem;
  }
  .hero__cta .sr-btn {
    padding: 0.8rem 1.6rem;
    font-size: var(--sr-text-base);
  }

  /* Scroll indicator: a pulsing dot at the bottom, inviting the reader down */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--sr-z-content);
    display: grid;
    place-items: center;
  }
  .hero__scroll-track {
    display: block;
    width: 24px;
    height: 38px;
    border: 1px solid var(--sr-border-strong);
    border-radius: var(--sr-radius-pill);
    position: relative;
  }
  .hero__scroll-dot {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--sr-accent);
    animation: hero-scroll 1.8s var(--sr-ease-in-out) infinite;
  }
  @keyframes hero-scroll {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      transform: translateY(16px);
      opacity: 0;
    }
  }

  @media (max-width: 480px) {
    .hero__cta .sr-btn {
      width: min(20rem, 100%);
    }
  }
</style>
