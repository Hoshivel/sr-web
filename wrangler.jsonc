// `npx wrangler deploy` 讀這一份，在 Cloudflare 的建置環境執行
// （組建命令 `npm run build`，生產分支 `main`）。本機不需要 wrangler，
// 因此它不在 package.json 的 dependencies 裡，也沒有 deploy script。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sr-web",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist",
    // 未匹配的路徑要拿到 `dist/404.html`。這個鍵的預設值是 `"none"`，而 `"none"`
    // 回的是一份**零位元組**的 404：瀏覽器把空 body 畫成白頁、分頁標題退回原始
    // URL，看起來就像站掛了。`src/pages/404.astro` 從初始提交就在、也一直建置得
    // 出 `dist/404.html`，缺的只有這一行——所以三者單獨看都正常，症狀卻指向別處。
    // 2026-09-03 打錯的 `/debug/full` 就是這樣被讀成全螢幕的災情。
    "not_found_handling": "404-page"
  }
}